# ─────────────────────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────────────────────
# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal chat ID (send /start to @userinfobot to get it)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude (task extraction + image OCR)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (Whisper voice transcription)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Notion
# ─────────────────────────────────────────────────────────────────────────────
# Integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_token_here

# The ID of your Tasks database (from the database URL)
# URL format: https://notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=your_notion_database_id_here

# ─────────────────────────────────────────────────────────────────────────────
# Daily reminder schedule
# ─────────────────────────────────────────────────────────────────────────────
# Time zone — see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Riyadh

# Morning reminder (24-hour format)
MORNING_HOUR=8
MORNING_MINUTE=0

# Evening reminder (24-hour format)
EVENING_HOUR=20
EVENING_MINUTE=0
